# API Configuration (Optional - yfinance works without API keys)
# ALPHA_VANTAGE_API_KEY=your_api_key_here
# FINANCIAL_MODELING_PREP_API_KEY=your_api_key_here

# Cache Settings
CACHE_ENABLED=true
CACHE_DIRECTORY=.cache
CACHE_EXPIRY_HOURS=24

# Scoring Weights (0-1, must sum to 1)
MOMENTUM_WEIGHT=0.4
FUNDAMENTAL_WEIGHT=0.6

# Analysis Parameters
DEFAULT_LOOKBACK_DAYS=365
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Recommendation Thresholds
STRONG_BUY_THRESHOLD=80
BUY_THRESHOLD=65
HOLD_THRESHOLD=45
SELL_THRESHOLD=30
